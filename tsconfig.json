{
  "compilerOptions": {
    "target":"ES2022",
    "lib":["ES2022","DOM","DOM.Iterable"],
    "module":"ESNext",
    "moduleResolution":"Bundler",
    "jsx":"react-jsx",
    "strict":true,
    "skipLibCheck":true,
    "noEmit":true,
    "esModuleInterop":true,
    "types":["node"],
    "baseUrl":".",
    "paths":{"@/*":["./*"]}
  },
  "include":["app","components","lib","server","vite.config.ts"]
}
